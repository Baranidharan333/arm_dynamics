<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>single_joint_description</name>
  <version>0.1.0</version>
  <description>
    URDF and meshes of the single-joint gravity compensation test rig: one DAMIAO DM4340
    swinging a 2.25 kg load on a 215 mm bar.
  </description>
  <maintainer email="ihrphysicalai@gmail.com">baranidharan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
