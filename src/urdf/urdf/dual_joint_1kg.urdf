<?xml version="1.0"?>
<!--
  Gravity compensation test rig: two revolute joints in series (both DM-J4340P), 2.25 kg load at
  the tip of the second bar.

  base_link => joint1 (revolute about -Y) => arm_link
            => motor2_joint (fixed) => motor2_link            (2nd motor housing, rides on arm 1)
            => joint2 (revolute about -Y, +0.270 m along X) => arm2_link
            => load_joint (fixed, +0.215 m along X) => load_link

  joint1's origin is pitched +90 deg, so arm_link +X points straight down at q1 = 0.
  joint2 has no rotation offset, so at q2 = 0 arm 2 continues straight along arm 1.
  Both axes are -Y, so the absolute angle of arm 2 from vertical is (q1 + q2).
  - q1 = 0, q2 = 0     : both arms hanging straight down (-Z)
  - q1 = +pi/2, q2 = 0 : both arms horizontal, pointing +X (worst case for joint1)

  - Arm 1: flat bar, m = 0.164 kg, 270 mm long (X) x 28 mm wide (Z) x 2 mm thick (Y),
    pivoting at one end, so its COM is 0.135 m from joint1's axis.
  - Arm 2: flat bar, m = 0.150 kg, 215 mm long (X) x 28 mm wide (Z) x 2 mm thick (Y),
    pivoting at one end, so its COM is 0.1075 m from joint2's axis.
  - Motor 2: DM-J4340P, 57 mm dia x 56.5 mm, m = 0.362 kg (ASSUMED - weigh it and update
    motor2_link's mass). Its housing is bolted to the tip of arm 1 on the +Y side, so it sits
    0.270 m from joint1's axis. Arm 2 is mounted on its output flange, offset +Y from arm 1.
  - Load: annular disk, m = 2.25 kg, ID = 20 mm, OD = 70 mm, thickness = 13 mm, at the far end
    of arm 2 (0.215 m from joint2's axis), its own axis parallel to the joint axes (Y).

  Gravity torque depends only on mass and COM position (the Y offsets do not change it).

  Expected holding torque (what JntToGravity should return), g = 9.81:
      tau2 = g * (m_load * L2 + m_bar2 * L2/2) * sin(q1 + q2)
           = 9.81 * (2.25 * 0.215 + 0.15 * 0.1075) * sin(q1 + q2)
           = 4.9038 * sin(q1 + q2)                                         [Nm]
      tau1 = g * (m_bar1 * L1/2 + (m_motor2 + m_bar2 + m_load) * L1) * sin(q1) + tau2
           = 9.81 * (0.164 * 0.135 + (0.362 + 0.15 + 2.25) * 0.270) * sin(q1) + tau2
           = 7.5329 * sin(q1) + 4.9038 * sin(q1 + q2)                      [Nm]

      q1       q2        tau1 [Nm]   tau2 [Nm]
      0        0          0.0000      0.0000
      0        pi/2       4.9038      4.9038
      pi/4     0          8.7941      3.4675
      pi/4     pi/4      10.2304      4.9038
      pi/2     0         12.4367      4.9038
      pi/2    -pi/2       7.5329      0.0000
-->
<robot name="dual_joint_1kg">

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.9 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.9 0.2 0.2 1.0"/>
  </material>

  <!-- Fixed base = DAMIAO DM-J4340P motor (57 mm dia x 56.5 mm). No inertial: it never moves,
       so it does not affect joint torques.
       meshes/dm4340p.stl is in metres, axis along +Y, output flange face at y = 0.
       Rotated 180 deg about Z so the body sits on -Y behind the bar, and shifted 1 mm so the
       flange touches the bar's back face (bar is 2 mm thick, centred on y = 0). -->
  <link name="base_link">
    <visual>
      <origin xyz="0 -0.001 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="package://single_joint_description/meshes/dm4340p.stl"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.0293 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0285" length="0.0565"/>
      </geometry>
    </collision>
  </link>

  <!-- Horizontal axis, so gravity loads the joint. Axis is -Y so positive q lifts the arm up.
       Peak gravity torque on joint1 is ~12.4 Nm (arms horizontal), so the effort limit is the
       motor's MIT torque range (28 Nm) instead of 10 Nm. -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <!-- Zero offset: q = 0 points the arm down. -->
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="28.0" velocity="5.0"/>
  </joint>

  <!-- Arm 1: flat bar 0.270 x 0.002 x 0.028 m (X x Y x Z), 164 g, pivot at the x = 0 end.
       Box inertia about its COM, m/12 * (a^2 + b^2):
       ixx = m/12 * (t^2 + w^2) = 1.0769e-5
       iyy = m/12 * (L^2 + w^2) = 1.00702e-3
       izz = m/12 * (L^2 + t^2) = 9.9636e-4 -->
  <link name="arm_link">
    <inertial>
      <origin xyz="0.135 0 0" rpy="0 0 0"/>
      <mass value="0.164"/>
      <inertia ixx="1.0769e-5" ixy="0" ixz="0" iyy="1.00702e-3" iyz="0" izz="9.9636e-4"/>
    </inertial>
    <visual>
      <origin xyz="0.135 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.270 0.002 0.028"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.135 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.270 0.002 0.028"/>
      </geometry>
    </collision>
  </link>

  <!-- Motor 2 housing, fixed to the tip of arm 1 on the +Y side.
       Frame origin = joint2's axis on arm 1's front face (x = 0.270, y = +0.001).
       Body spans y = 0 .. 0.0565 in this frame; output flange at y = 0.0565. -->
  <joint name="motor2_joint" type="fixed">
    <parent link="arm_link"/>
    <child link="motor2_link"/>
    <origin xyz="0.270 0.001 0" rpy="0 0 0"/>
  </joint>

  <!-- DM-J4340P as a solid cylinder, axis along Y, r = 0.0285 m, h = 0.0565 m.
       m = 0.362 kg (ASSUMED - weigh your motor and update).
       iyy       = m/2  * r^2              = 1.4702e-4
       ixx = izz = m/12 * (3 r^2 + h^2)    = 1.6981e-4
       Mesh rotated 180 deg about Z (body on -Y of the flange) and shifted so the flange
       sits at y = 0.0565, i.e. the body sits between arm 1 and arm 2. -->
  <link name="motor2_link">
    <inertial>
      <origin xyz="0 0.02825 0" rpy="0 0 0"/>
      <mass value="0.362"/>
      <inertia ixx="1.6981e-4" ixy="0" ixz="0" iyy="1.4702e-4" iyz="0" izz="1.6981e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0.0565 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="package://single_joint_description/meshes/dm4340p.stl"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0.02825 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0285" length="0.0565"/>
      </geometry>
    </collision>
  </link>

  <!-- Second joint: same motor, axis -Y like joint1, so positive q2 also lifts arm 2.
       Origin is on motor 2's flange; arm 2 (2 mm thick) is centred 1 mm in front of it.
       q2 = 0: arm 2 is in line with arm 1. -->
  <joint name="joint2" type="revolute">
    <parent link="motor2_link"/>
    <child link="arm2_link"/>
    <origin xyz="0 0.0575 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="28.0" velocity="5.0"/>
  </joint>

  <!-- Arm 2: flat bar 0.215 x 0.002 x 0.028 m (X x Y x Z), 150 g, pivot at the x = 0 end.
       ixx = 9.850e-6, iyy = 5.8761e-4, izz = 5.7786e-4 (box inertia about its COM). -->
  <link name="arm2_link">
    <inertial>
      <origin xyz="0.1075 0 0" rpy="0 0 0"/>
      <mass value="0.150"/>
      <inertia ixx="9.850e-6" ixy="0" ixz="0" iyy="5.8761e-4" iyz="0" izz="5.7786e-4"/>
    </inertial>
    <visual>
      <origin xyz="0.1075 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.215 0.002 0.028"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.1075 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.215 0.002 0.028"/>
      </geometry>
    </collision>
  </link>

  <!-- Load now sits at the tip of arm 2. -->
  <joint name="load_joint" type="fixed">
    <parent link="arm2_link"/>
    <child link="load_link"/>
    <origin xyz="0.215 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 2.25 kg disk at the tip, axis along Y.
       Inertia only affects dynamics, not the gravity torque. -->
  <link name="load_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.25"/>
      <inertia
        ixx="7.769925e-4"
        ixy="0"
        ixz="0"
        iyy="1.490625e-3"
        iyz="0"
        izz="7.769925e-4"/>
    </inertial>

    <!-- Solid cylinder, cylinder Z rotated to Y -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.013"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.013"/>
      </geometry>
    </collision>
  </link>

  <!-- ros2_control block: two DM4340 on can0 (IDs 1 and 2), driven by hw_interface in MIT mode.
       ArmHardwareInterface has no zero offset (q = motor position * direction), so both motors'
       zeros must be set with both arms hanging straight down (q1 = q2 = 0 in this URDF).
       kp / kd / direction / control_modes are per motor (comma separated, same order as
       motor_ids); p_max / v_max / t_max take one value for all motors. -->
  <ros2_control name="DualJointSystem" type="system">
    <hardware>
      <plugin>arm_hardware/ArmHardwareInterface</plugin>

      <param name="can_interface">can0</param>
      <param name="motor_ids">1,2</param>
      <!-- kp 0: the arms are moved by hand and joint_cmd's position target has no effect.
           Raise it to make the joints follow /joint_cmd. -->
      <param name="kp">0.0,0.0</param>
      <param name="kd">0.05,0.05</param>
      <!-- Motor positive moves opposite to URDF positive. Check motor 2's sign on the rig:
           mounted the same way as motor 1 it should also be -1. -->
      <param name="direction">-1,-1</param>
      <param name="control_modes">mit,mit</param>
      <!-- MIT mapping ranges: must equal the motor's PMAX/VMAX/TMAX registers
           (DM4340 scan: 12.5 / 10 / 28). Wrong values scale torque/velocity. -->
      <param name="p_max">12.5</param>
      <param name="v_max">10.0</param>
      <param name="t_max">28.0</param>

    </hardware>
    <joint name="joint1">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint2">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
