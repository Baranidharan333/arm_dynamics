<?xml version="1.0"?>
<!--
  Gravity compensation test rig: one revolute joint, 2.25 kg load 0.215 m from the axis.

  base_link => joint1 (revolute about -Y) => arm_link => load_joint (fixed, +0.215 m along X) => load_link

  joint1's origin is pitched +90 deg, so arm_link +X points straight down at q = 0:
  - q = 0     : arm hanging straight down (-Z)
  - q = +pi/2 : arm horizontal, pointing +X
  - Arm: flat bar, m = 0.150 kg, 215 mm long (X) x 28 mm wide (Z) x 2 mm thick (Y),
    pivoting at one end, so its COM is 0.1075 m from the joint axis.
  - Load: annular disk, m = 2.25 kg, ID = 20 mm, OD = 70 mm, thickness = 13 mm.
    Mounted at the far end of the bar: its centre sits 0.215 m from the joint axis and its own
    axis is parallel to the joint axis (Y).

  Gravity torque depends only on mass and COM position, so the disk shape does not change it.

  Expected holding torque (what JntToGravity should return):
      tau_g(q) = g * (m_load * L_load + m_bar * L_bar) * sin(q)
               = 9.81 * (2.25 * 0.215 + 0.15 * 0.1075) * sin(q)
               = (4.7456 load + 0.1582 bar) * sin(q) = 4.9038 * sin(q) [Nm]
      q = 0      -> 0.0000 Nm
      q = pi/4   -> 3.4675 Nm
      q = pi/2   -> 4.9038 Nm
      q = -pi/4  -> -3.4675 Nm
-->
<robot name="single_joint_1kg">

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.9 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.9 0.2 0.2 1.0"/>
  </material>

  <!-- Fixed base = DAMIAO DM-J4340P motor (57 mm dia x 56.5 mm). No inertial: it never moves,
       so it does not affect joint torques.
       meshes/dm4340p.stl is in metres, axis along +Y, output flange face at y = 0.
       Rotated 180 deg about Z so the body sits on -Y behind the bar, and shifted 1 mm so the
       flange touches the bar's back face (bar is 2 mm thick, centred on y = 0). -->
  <link name="base_link">
    <visual>
      <origin xyz="0 -0.001 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="package://single_joint_description/meshes/dm4340p.stl"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.0293 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0285" length="0.0565"/>
      </geometry>
    </collision>
  </link>

  <!-- Horizontal axis, so gravity loads the joint. Axis is -Y so positive q lifts the arm up. -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <!-- Zero offset: q = 0 points the arm down (equivalent to the old q = -pi/2). -->
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="5.0"/>
  </joint>

  <!-- Flat bar 0.215 x 0.002 x 0.028 m (X x Y x Z), 150 g, pivot at the x = 0 end.
       Box inertia about its COM, m/12 * (a^2 + b^2):
       ixx = m/12 * (t^2 + w^2) = 9.850e-6
       iyy = m/12 * (L^2 + w^2) = 5.8761e-4
       izz = m/12 * (L^2 + t^2) = 5.7786e-4 -->
  <link name="arm_link">
    <inertial>
      <origin xyz="0.1075 0 0" rpy="0 0 0"/>
      <mass value="0.150"/>
      <inertia ixx="9.850e-6" ixy="0" ixz="0" iyy="5.8761e-4" iyz="0" izz="5.7786e-4"/>
    </inertial>
    <visual>
      <origin xyz="0.1075 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.215 0.002 0.028"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.1075 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.215 0.002 0.028"/>
      </geometry>
    </collision>
  </link>

  <joint name="load_joint" type="fixed">
    <parent link="arm_link"/>
    <child link="load_link"/>
    <origin xyz="0.215 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 1 kg annular disk at the tip, axis along Y.
       r1 = 0.010 m, r2 = 0.035 m, h = 0.013 m
       I_axis (iyy)      = m/2  * (r1^2 + r2^2)          = 6.625e-4 kg m^2
       I_trans (ixx,izz) = m/12 * (3(r1^2 + r2^2) + h^2) = 3.4533e-4 kg m^2
       Inertia only affects dynamics, not the gravity torque. -->
<!-- Inertia only affects dynamics, not the gravity torque. -->
  <link name="load_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.25"/>
      <inertia
        ixx="7.769925e-4"
        ixy="0"
        ixz="0"
        iyy="1.490625e-3"
        iyz="0"
        izz="7.769925e-4"/>
    </inertial>

    <!-- Solid cylinder, cylinder Z rotated to Y -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.013"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.013"/>
      </geometry>
    </collision>
  </link>

  <!-- ros2_control block: one DM4340 on can0, driven by hw_interface in MIT mode.
       ArmHardwareInterface has no zero offset (q = motor position * direction), so the motor's
       zero must be set with the arm hanging straight down (q = 0 in this URDF). -->
  <ros2_control name="SingleJointSystem" type="system">
    <hardware>
      <plugin>arm_hardware/ArmHardwareInterface</plugin>

      <param name="can_interface">can0</param>
      <param name="motor_ids">1</param>
      <!-- kp 0: the arm is moved by hand and joint_cmd's position target has no effect.
           Raise it to make the joint follow /joint_cmd. -->
      <param name="kp">0.0</param>
      <param name="kd">0.05</param>
      <!-- Motor positive moves opposite to URDF positive (same as test.py's default). -->
      <param name="direction">-1</param>
      <param name="control_modes">mit</param>
      <!-- MIT mapping ranges: must equal the motor's PMAX/VMAX/TMAX registers
           (DM4340 scan: 12.5 / 10 / 28). Wrong values scale torque/velocity. -->
      <param name="p_max">12.5</param>
      <param name="v_max">10.0</param>
      <param name="t_max">28.0</param>

    </hardware>
    <joint name="joint1">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
